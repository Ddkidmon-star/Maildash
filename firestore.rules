rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(email) {
      return request.auth.token.email == email;
    }

    function isAppOwner() {
      return isSignedIn() && request.auth.token.email == "preciousddkid@gmail.com";
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAppOwner());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAppOwner());
    }
  }
}
